{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bryllun",
  "mainBinaryName": "bryllun",
  "version": "0.1.6",
  "identifier": "sh.perpe.bryllun",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bryllun",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg/background.png"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/md2perpe/bryllun/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNDFBMjFEQUZBNTI1MjMKUldRakphV3ZIYUpCN0hyWkZMTWs2Wm9pYm1hOGh6QkVkWnNSMXd5TlVjYy8rQjFTTnErcTZaQS8K"
    }
  }
}
